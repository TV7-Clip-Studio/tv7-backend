APP_NAME=My FastAPI Service
APP_ENV=dev
DEBUG=true
VERSION=0.1.0
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
TRUSTED_HOSTS=["*"]
BACKEND_BASE_URL=http://localhost:8000
# DATABASE_URL should point to the async driver (Neon pooler or local Postgres)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/appdb
# DATABASE_ADMIN_URL uses the sync driver (direct Neon compute or local Postgres) for Alembic migrations
DATABASE_ADMIN_URL=postgresql+psycopg://postgres:postgres@localhost:5432/appdb
BETA_API_KEY=dev-beta-key
AGENTKIT_URL=
AGENTKIT_API_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
REDIS_URL=redis://localhost:6379/0
# Use "stub" to run the pipeline inline (no worker required) or "redis" to dispatch to workers.
DRAMATIQ_BROKER=stub
WORKER_CONCURRENCY=4
JWT_SECRET=super-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRES_MINUTES=10080
MEDIA_STORAGE_DIR=./media
VIDEO_QUALITY=720p
MAX_VIDEO_FILE_SIZE_MB=500
OPENAI_API_KEY=sk-proj-...
# Google OAuth (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_PATH=/api/v1/auth/google/callback
OAUTH_STATE_SECRET=change-me-oauth-state
# UI smoke test credentials (optional - for Playwright tests)
UI_ADMIN_EMAIL=
UI_ADMIN_PASSWORD=
# Docker Compose host overrides (local development only)
COMPOSE_PROJECT_NAME=tv7
API_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
