APP_NAME=TV7 Backend
APP_ENV=dev
DEBUG=true
VERSION=0.1.0
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8080","http://127.0.0.1:8080","http://localhost:5173","http://127.0.0.1:5173","tauri://localhost","http://tauri.localhost"]
TRUSTED_HOSTS=["*"]
API_SCHEME=http
API_HOST=127.0.0.1
API_PORT=8000
# Admin credentials for /admin UI
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
# DATABASE_URL should point to the async driver (Neon pooler or local Postgres)
# Docker-first defaults to the Compose service host; for host-only runs override host to localhost.
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/appdb
# DATABASE_ADMIN_URL uses the sync driver (direct Neon compute or local Postgres) for Alembic migrations
DATABASE_ADMIN_URL=postgresql+psycopg://postgres:postgres@postgres:5432/appdb
JWT_SECRET=super-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRES_MINUTES=10080
SOURCE_MEDIA_STORAGE_DIR=./private_media/videos
SCHEDULED_ASSET_STORAGE_DIR=./private_media/assets
# Approved rendered assets: local for development; s3 for separate API/worker machines.
ASSET_STORAGE_BACKEND=local
ASSET_S3_BUCKET=
ASSET_S3_REGION=
ASSET_S3_ENDPOINT_URL=
ASSET_S3_ACCESS_KEY_ID=
ASSET_S3_SECRET_ACCESS_KEY=
ASSET_S3_SESSION_TOKEN=
ASSET_S3_PREFIX=tv7/approved-assets
# Google OAuth web client; redirect URI must exactly match Google Cloud configuration.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=
# Comma-separated Fernet keys (first encrypts; all decrypt for rotation). Never use JWT_SECRET here.
YOUTUBE_TOKEN_ENCRYPTION_KEYS=
# Enable only after OAuth consent, API project audit, and live private/public upload verification.
YOUTUBE_PUBLISH_ENABLED=false
YOUTUBE_API_AUDIT_APPROVED=false
UPLOAD_MAX_FILE_SIZE_MB=4096
# Docker Compose host overrides (local development only)
COMPOSE_PROJECT_NAME=tv7
POSTGRES_PORT=5432
DEEPSEEK_API_KEY=""
